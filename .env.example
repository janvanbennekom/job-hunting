# JobHunter — copy to .env for local development (placeholders only; never commit .env)

# Application (use production on Synology NAS)
JOBHUNTER_ENV=development
JOBHUNTER_LOG_LEVEL=INFO

# PostgreSQL — production: external server URL only (no bundled db container)
# JOBHUNTER_DATABASE_URL=postgresql+psycopg://user:password@db-host:5432/job_hunter
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=job_hunter
# POSTGRES_USER=jobhunter
# POSTGRES_PASSWORD=change_me

# Phase 8 — required for production worker assessment (never commit real keys)
# JOBHUNTER_OPENAI_API_KEY=
# JOBHUNTER_OPENAI_MODEL=
# CLI dev/test without OpenAI: scripts/assess_opportunity_profile.py --provider fake

# Phase 13 — automation JSON (copy config/automation.example.json → config/automation.json)
# JOBHUNTER_AUTOMATION_CONFIG=/config/automation.json

# Docker / compose (local bundled PostgreSQL uses --profile bundled-db)
# POSTGRES_PASSWORD=change_me
# JOBHUNTER_WEB_PORT=8501
# JOBHUNTER_AUTOMATION_CONFIG_HOST=./config/automation.json
# JOBHUNTER_EDGE_PORT=8080

# SMTP — required in production when notifications are enabled
# JOBHUNTER_SMTP_HOST=
# JOBHUNTER_SMTP_PORT=587
# JOBHUNTER_SMTP_USER=
# JOBHUNTER_SMTP_PASSWORD=
# JOBHUNTER_SMTP_FROM=jobhunter@example.com
# JOBHUNTER_SMTP_TO=you@example.com
# JOBHUNTER_SMTP_USE_SSL=false
# JOBHUNTER_SMTP_STARTTLS=true

# Public site root for HIGH alert deep links ( /app is appended automatically )
# JOBHUNTER_WEB_BASE_URL=https://jobhunter.jvbgis.com

# oauth2-proxy (production edge — set in .env, read by oauth2-proxy service)
# OAUTH2_PROXY_PROVIDER=google
# OAUTH2_PROXY_CLIENT_ID=
# OAUTH2_PROXY_CLIENT_SECRET=
# OAUTH2_PROXY_COOKIE_SECRET=
# OAUTH2_PROXY_REDIRECT_URL=https://jobhunter.jvbgis.com/app/oauth2/callback
# JOBHUNTER_OAUTH2_ALLOWED_EMAILS_HOST=./config/oauth2-proxy/allowed_emails.txt
